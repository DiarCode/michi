# Michi Backend Configuration
# Copy this file to .env and customize values

# Database connection string (SQLite for dev, Postgres/TimescaleDB for prod)
DATABASE_URL=sqlite:///./data/michi.db

# Redis URL for Celery broker and WebSocket pub/sub
REDIS_URL=redis://localhost:6379/0

# CORS: Comma-separated list of allowed origins.
# Set to "*" to allow all origins (NOT recommended for production).
ALLOWED_ORIGINS=http://localhost:3100,http://localhost:5173,http://localhost:8600,http://localhost:8000,http://localhost:8100

# WebSocket authentication secret. If not set, WS connections are allowed without auth (dev mode).
WS_AUTH_SECRET=

# Model artifact path for DTS-GSSF
MODEL_ARTIFACT_PATH=checkpoints/model_best.pt

# Celery broker URL (defaults to REDIS_URL if not set)
CELERY_BROKER_URL=

# Frontend API URL (used by Streamlit)
API_URL=http://backend:8000