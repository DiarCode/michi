# When deployed via docker-compose, the nginx sidecar in the dashboard
# container already proxies /api and /ws to the backend. So we leave these
# empty so axios / WebSocket construct relative URLs (e.g. /api/v1/stations
# and /ws/realtime) and go through the proxy.
#
# For local dev outside docker, override these in `.env.local`:
#   VITE_API_URL=http://localhost:8100/api/v1
#   VITE_WS_URL=ws://localhost:8100/ws/realtime
VITE_API_URL=
VITE_WS_URL=
