{
  "window": {
    "lookback": 72,
    "horizon": 4,
    "stride": 1
  },
  "split": {
    "train_frac": 0.7,
    "val_frac": 0.15,
    "test_frac": 0.15
  },
  "train": {
    "epochs": 3,
    "batch_size": 32,
    "lr": 0.0003,
    "lr_min": 1e-06,
    "weight_decay": 0.001,
    "grad_clip": 1.0,
    "loss_bottom_weight": 1.3,
    "loss_agg_weight": 0.7,
    "warmup_epochs": 20,
    "use_cosine_schedule": true,
    "early_stopping_patience": 50,
    "early_stopping_min_delta": 0.0001,
    "accumulation_steps": 1
  },
  "model": {
    "d_model": 192,
    "horizon": 4,
    "K": 3,
    "lora_r": 16,
    "n_heads": 6,
    "dropout": 0.1
  },
  "n_seeds": 1,
  "device": "cuda"
}